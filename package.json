{
  "name": "train-ticket",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "start": "expo start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write src",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm coverage",
    "coverage": "jest --coverage",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "lucide-react-native": "^1.70.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "\\.css$": "<rootDir>/jest.css-stub.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/__tests__/**",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 95,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "prettier": {
    "singleQuote": true
  }
}
